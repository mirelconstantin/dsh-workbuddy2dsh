{
  "name": "dsh-workbuddy2dsh",
  "version": "2.0.0",
  "description": "dsh-workbuddy2dsh inside DeepSeek Harness: runs the self-hosted gateway as a sidecar and publishes its models (including the free DeepSeek V4.1 Flash) into the normal model picker as two lanes — free and account-metered. No proxy, no exit pool.",
  "icon": "./icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "src",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "bin",
    "scripts",
    "docs",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "dsh-plugins",
    "dsh-external",
    "cordis",
    "plugin",
    "workbuddy",
    "codebuddy",
    "tencent",
    "dsh-workbuddy2dsh",
    "codebuddy2api",
    "llm-provider",
    "llm-adapter",
    "llm",
    "ai-models",
    "free-models",
    "free-llm",
    "free-ai",
    "deepseek",
    "deepseek-v4-1-flash",
    "deepseek-v4.1-flash",
    "glm",
    "kimi",
    "openai-compatible",
    "openai-api",
    "chat-completions",
    "self-hosted",
    "gateway",
    "api-gateway",
    "reverse-proxy",
    "account-pool",
    "credits",
    "nodejs"
  ],
  "license": "MIT",
  "author": "Mirel Constantinescu (https://github.com/mirelconstantin)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirelconstantin/dsh-workbuddy2dsh.git"
  },
  "homepage": "https://github.com/mirelconstantin/dsh-workbuddy2dsh#readme",
  "bugs": {
    "url": "https://github.com/mirelconstantin/dsh-workbuddy2dsh/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      }
    }
  },
  "scripts": {
    "test": "node --test test/provider.test.js test/gateway-config.test.js test/bridge.test.js test/runtime.test.js test/plugin.test.js",
    "check": "node --check index.js && node scripts/check-plugin.mjs",
    "e2e": "node scripts/e2e-gateway.mjs",
    "build:gateway": "node scripts/build-gateway.mjs",
    "setup": "node scripts/build-gateway.mjs",
    "typecheck": "tsc --noEmit",
    "build:client": "tsdown -c tsdown.client.config.ts",
    "build": "npm run typecheck && npm run build:client"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
